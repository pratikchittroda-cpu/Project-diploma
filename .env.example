# Public client identifiers only. These values are bundled and are NOT secrets.
# Local development may copy this to .env. EAS builds exclude .env and require
# values provisioned in the development/preview/production EAS environment.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
# Optional future server-feature setup, NOT required for the current Spark core:
# Native Firebase files are BUILD-ONLY paths, never public @env imports.
# Provision each platform's file from the SAME Firebase project as the JS values above.
# For EAS use file environment variables. Do not commit/upload local credential files.
# Backend features are disabled by config/releaseFeatures.js in the core release.
GOOGLE_SERVICES_JSON=
GOOGLE_SERVICES_PLIST=
# Register Android App Check with Play Integrity + release SHA-256 and Play distribution.
# Register iOS App Attest and DeviceCheck fallback + signing capability in Firebase/Apple.
# No debug provider/token is supported. Tokens are requested on demand; auto-refresh is off.
# Firebase JS login/ledger development remains available without these native files.
# Google Web OAuth client is the ID-token audience for Firebase Auth.
GOOGLE_WEB_CLIENT_ID=
# iOS client must belong to com.nustudent.expenzo; native URL scheme is derived.
GOOGLE_IOS_CLIENT_ID=
# Android OAuth is configured with package + release signing fingerprints in Google/Firebase.
GOOGLE_ANDROID_CLIENT_ID=
# Leave API_BASE_URL empty for core. Only a future reviewed server release uses it.
API_BASE_URL=
# Public EAS Hosting API URL, including /api. Never put the provider key here.
AI_API_BASE_URL=
PRIVACY_POLICY_URL=https://project1-7a465.web.app/privacy.html
ACCOUNT_DELETION_URL=https://project1-7a465.web.app/account-deletion.html
SUPPORT_EMAIL=pratikchittroda@gmail.com

# Build-only release metadata; not allowlisted into the client bundle.
# Supply truthful values in the build environment after publishing/reviewing policies.
LEGAL_ENTITY_NAME=Expenzo
DATA_RETENTION_SUMMARY=Core Auth and Firestore records remain until deleted by the user or removed by the publisher following ownership verification. Deletion requests are manual with no guaranteed response or completion deadline. AI and cloud photo uploads are disabled.
AI_PROVIDER_NAME=
AI_PROVIDER_RETENTION_SUMMARY=
