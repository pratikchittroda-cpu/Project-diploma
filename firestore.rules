rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function unlocked() { return signedIn() && !exists(/databases/$(database)/documents/deletionJobs/$(request.auth.uid)); }
    function company() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'company'; }
    function text(value, max) { return value is string && value.size() <= max; }
    function requiredText(value, max) { return text(value, max) && value.trim().size() > 0; }
    function money(value) { return value is number && value > 0 && value <= 1000000000 && value == math.round(value * 100) / 100.0; }
    function timestampText(value) { return text(value, 24) && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][.][0-9]{3}Z$') && dateOnly(value.split('T')[0]); }
    function dateOnly(value) {
      let parts = value is string ? value.split('-') : [];
      let year = parts.size() == 3 ? int(parts[0]) : 0;
      let month = parts.size() == 3 ? int(parts[1]) : 0;
      let day = parts.size() == 3 ? int(parts[2]) : 0;
      let leap = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && year >= 1900 && year <= 9999 && month >= 1 && month <= 12 && day >= 1 && day <= (month == 2 ? (leap ? 29 : 28) : (month in [4,6,9,11] ? 30 : 31));
    }
    function category(value) { return value in ['food','transport','shopping','entertainment','bills','health','education','other','salary','freelance','business','investment','gift','salaries','marketing','office-supplies','professional-services','travel','utilities','equipment','software','rent','sales','services','consulting','insurance']; }
    function expenseCategory(value) { return value in ['food','transport','shopping','entertainment','bills','health','education','other','salaries','marketing','office-supplies','professional-services','travel','utilities','equipment','software','rent','insurance']; }
    function incomeCategory(value) { return value in ['salary','freelance','business','investment','gift','sales','services','consulting','other']; }
    function common(d) { return owner(d.userId) && timestampText(d.createdAt) && timestampText(d.updatedAt); }
    function unchanged(field) { return request.resource.data.get(field, null) == resource.data.get(field, null); }
    function scope(d) {
      return (!('userType' in d) || d.userType == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType)
        && (!('companyId' in d) || (company() && d.companyId == request.auth.uid));
    }
    function transaction(d) {
      return d.keys().hasOnly(['userId','type','amount','description','category','date','createdAt','updatedAt','department','companyId','userType','autoGenerated','memberId','salaryMonth','note','paymentMethod'])
        && common(d) && d.type in ['income','expense'] && money(d.amount) && requiredText(d.description,500)
        && (d.type == 'expense' ? expenseCategory(d.category) : incomeCategory(d.category)) && dateOnly(d.date) && scope(d)
        && text(d.get('department',''),120) && text(d.get('note',''),1000) && text(d.get('paymentMethod',''),40)
        && (!('autoGenerated' in d) || (company() && d.autoGenerated is bool))
        && (!('memberId' in d) || (company() && text(d.memberId,200)))
        && (!('salaryMonth' in d) || (company() && d.salaryMonth.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')));
    }
    function budget(d) {
      return d.keys().hasOnly(['userId','category','categoryName','amount','period','name','type','archived','createdAt','updatedAt'])
        && common(d) && expenseCategory(d.category) && money(d.amount) && d.period in ['Weekly','Monthly','Yearly']
        && text(d.get('categoryName',''),120) && text(d.get('name',''),120) && d.get('archived',false) is bool
        && (!('type' in d) || d.type == 'personal' || (d.type == 'company' && company()));
    }
    function profile(d, uid) {
      return d.keys().hasOnly(['uid','email','fullName','userType','createdAt','updatedAt','profileComplete','provider','phone','companyName','contactPerson','industry','companySize','address','website','profileImageUri','companyLogoUri','employeeCount','activeProjects','monthlyBudget','budgets','preferences'])
        && d.uid == uid && text(d.email,254) && requiredText(d.fullName,120)
        && d.userType in ['personal','company'] && timestampText(d.createdAt) && timestampText(d.updatedAt)
        && d.get('profileComplete',false) is bool && d.get('provider','password') in ['password','google','email']
        && text(d.get('phone',''),40) && text(d.get('companyName',''),160) && text(d.get('contactPerson',''),120)
        && text(d.get('industry',''),120) && text(d.get('companySize',''),40) && text(d.get('address',''),500) && text(d.get('website',''),500)
        && text(d.get('profileImageUri',''),2048) && text(d.get('companyLogoUri',''),2048);
    }
    match /users/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid) && unlocked() && profile(request.resource.data, uid) && request.resource.data.email == request.auth.token.email
        && !request.resource.data.keys().hasAny(['employeeCount','activeProjects','monthlyBudget','budgets','preferences']);
      allow update: if owner(uid) && unlocked() && profile(request.resource.data, uid) && unchanged('uid') && unchanged('email') && unchanged('userType') && unchanged('provider') && unchanged('createdAt')
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['employeeCount','activeProjects','monthlyBudget','budgets','preferences']);
      // Only the authenticated server deletion workflow may remove profiles.
      allow delete: if false;
    }
    match /transactions/{id} {
      // A deterministic salary transaction must read its missing target before creating it.
      // This get-only exception exposes no data and never broadens collection queries.
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/transactions/$(id)) || owner(resource.data.userId));
      allow list: if owner(resource.data.userId);
      allow create: if unlocked() && transaction(request.resource.data);
      allow update: if unlocked() && owner(resource.data.userId) && transaction(request.resource.data) && unchanged('userId') && unchanged('type') && unchanged('userType') && unchanged('companyId') && unchanged('createdAt') && unchanged('autoGenerated') && unchanged('memberId') && unchanged('salaryMonth');
      allow delete: if unlocked() && owner(resource.data.userId);
    }
    match /budgets/{id} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/budgets/$(id)) || owner(resource.data.userId));
      allow list: if owner(resource.data.userId);
      allow create: if unlocked() && budget(request.resource.data);
      allow update: if unlocked() && owner(resource.data.userId) && budget(request.resource.data) && unchanged('userId') && unchanged('type') && unchanged('createdAt');
      allow delete: if unlocked() && owner(resource.data.userId);
    }
    function team(d) {
      return d.keys().hasOnly(['userId','name','budget','color','icon','createdAt','updatedAt']) && common(d)
        && requiredText(d.name,100) && money(d.budget) && text(d.get('color',''),40) && text(d.get('icon',''),80);
    }
    function member(d) {
      return d.keys().hasOnly(['userId','name','email','role','salary','department','status','joinDate','avatar','color','createdAt','updatedAt']) && common(d)
        && requiredText(d.name,100) && text(d.email,254) && requiredText(d.role,100) && money(d.salary)
        && requiredText(d.department,100) && d.status in ['active','inactive'] && dateOnly(d.joinDate) && text(d.get('avatar',''),80) && text(d.get('color',''),40);
    }
    match /teams/{id} {
      allow read: if company() && owner(resource.data.userId);
      allow create: if unlocked() && company() && team(request.resource.data);
      allow update: if unlocked() && company() && owner(resource.data.userId) && team(request.resource.data) && unchanged('userId') && unchanged('createdAt');
      allow delete: if unlocked() && company() && owner(resource.data.userId);
    }
    match /members/{id} {
      allow read: if company() && owner(resource.data.userId);
      allow create: if unlocked() && company() && member(request.resource.data);
      allow update: if unlocked() && company() && owner(resource.data.userId) && member(request.resource.data) && unchanged('userId') && unchanged('createdAt');
      allow delete: if unlocked() && company() && owner(resource.data.userId);
    }
    // Hosted AI reservations use the caller's ID token. The only writable usage
    // documents are today's two bounded counters, incremented together.
    function aiUsageDay(day) {
      let parts = day.split('-');
      return dateOnly(day) && int(parts[0]) == request.time.year()
        && int(parts[1]) == request.time.month() && int(parts[2]) == request.time.day();
    }
    function aiUsageFields(d, cap) {
      return d.keys().hasAll(['count','updatedAt']) && d.keys().hasOnly(['count','updatedAt'])
        && d.count is int && d.count >= 1 && d.count <= cap
        && d.updatedAt is timestamp && d.updatedAt == request.time;
    }
    function aiUsageCreate(day, cap) {
      return aiUsageDay(day) && aiUsageFields(request.resource.data, cap) && request.resource.data.count == 1;
    }
    function aiUsageUpdate(day, cap) {
      return aiUsageDay(day) && aiUsageFields(request.resource.data, cap)
        && resource.data.keys().hasAll(['count','updatedAt']) && resource.data.keys().hasOnly(['count','updatedAt'])
        && resource.data.count is int && resource.data.count >= 1 && resource.data.count < cap
        && resource.data.updatedAt is timestamp && request.resource.data.count == resource.data.count + 1;
    }
    function aiGlobalPaired(day) {
      let path = /databases/$(database)/documents/globalAIUsage/$(day);
      let before = exists(path) ? get(path).data.count : 0;
      let after = getAfter(path).data;
      return before is int && after.count == before + 1 && after.updatedAt == request.time;
    }
    function aiOwnerPaired(day) {
      let path = /databases/$(database)/documents/aiUsage/$(request.auth.uid)/days/$(day);
      let before = exists(path) ? get(path).data.count : 0;
      let after = getAfter(path).data;
      return before is int && after.count == before + 1 && after.updatedAt == request.time;
    }
    match /aiUsage/{uid}/days/{day} {
      allow get: if owner(uid) && unlocked() && aiUsageDay(day);
      allow list: if false;
      allow create: if owner(uid) && unlocked() && aiUsageCreate(day, 20) && aiGlobalPaired(day);
      allow update: if owner(uid) && unlocked() && aiUsageUpdate(day, 20) && aiGlobalPaired(day);
      allow delete: if false;
    }
    match /globalAIUsage/{day} {
      allow get: if signedIn() && unlocked() && aiUsageDay(day);
      allow list: if false;
      allow create: if signedIn() && unlocked() && aiUsageCreate(day, 200) && aiOwnerPaired(day);
      allow update: if signedIn() && unlocked() && aiUsageUpdate(day, 200) && aiOwnerPaired(day);
      allow delete: if false;
    }
    // Reports, other quotas, AI receipts, deletion jobs and unknown paths are server-only.
    match /{document=**} { allow read, write: if false; }
  }
}
