{
  "name": "expenzo",
  "license": "0BSD",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start --go",
    "start:dev-client": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "node scripts/sync-ios.cjs && expo run:ios",
    "web": "expo start --web",
    "check:source": "node scripts/check-source.cjs",
    "lint": "npm run check:source",
    "test": "node scripts/test-unit.cjs",
    "test:rules": "npm --prefix functions run test:rules",
    "test:backend": "npm --prefix functions test",
    "check:config": "node scripts/validate-release-config.cjs",
    "check:release": "node scripts/validate-release-config.cjs --production",
    "check:expo": "expo install --check",
    "doctor": "expo-doctor",
    "export:android": "expo export --platform android --output-dir .expo/release-export",
    "eas-build-pre-install": "npm install --global npm@11.11.0",
    "eas-build-post-install": "node scripts/prepare-build.cjs",
    "postinstall": "node scripts/patch-rnfirebase-app-check.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "~0.4.3",
    "@expo-google-fonts/syne": "~0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "26.4.0",
    "@react-native-firebase/app-check": "26.4.0",
    "@react-native-google-signin/google-signin": "16.1.5",
    "@react-navigation/bottom-tabs": "^7.4.2",
    "@react-navigation/native": "^7.1.14",
    "@react-navigation/native-stack": "^7.3.21",
    "expo": "~58.0.23",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-splash-screen": "~58.0.13",
    "expo-system-ui": "~58.0.7",
    "firebase": "12.19.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/parser": "^7.28.0",
    "@expo/plist": "^0.5.2",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "expo-doctor": "1.20.4",
    "globals": "^16.0.0",
    "react-native-dotenv": "^3.4.11"
  },
  "engines": {
    "node": ">=22.23.3 <23",
    "npm": ">=11.11.0 <12"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.5"
    },
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "packageManager": "npm@11.11.0",
  "private": true
}
