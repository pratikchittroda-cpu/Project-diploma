{
  "expo": {
    "name": "Expenzo",
    "slug": "Expenzo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nustudent.expenzo",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choose a profile picture to upload to your Expenzo account.",
        "ITSAppUsesNonExemptEncryption": false,
        "FirebaseAppCheckTokenAutoRefreshEnabled": false,
        "FirebaseDataCollectionDefaultEnabled": false
      },
      "entitlements": {"com.apple.developer.devicecheck.appattest-environment": "production"}
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f3f5ff"
      },
      "allowBackup": false,
      "permissions": [],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "package": "com.nustudent.expenzo",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "expenzo",
    "plugins": [
      "expo-font",
      ["expo-image-picker", {"photosPermission": "Choose a profile picture to upload to your Expenzo account.", "cameraPermission": false, "microphonePermission": false}],
      ["expo-build-properties", {"android": {"compileSdkVersion": 37, "targetSdkVersion": 36}, "ios": {"deploymentTarget": "16.4", "useFrameworks": "static", "forceStaticLinking": ["RNFBApp", "RNFBAppCheck"]}}],
      ["expo-splash-screen", {"image": "./assets/logo.png", "backgroundColor": "#f3f5ff", "resizeMode": "contain", "imageWidth": 160}]
    ],
    "extra": {
      "eas": {
        "projectId": "9841edbd-f161-4d8b-95b3-867f45d42ccf"
      }
    }
  }
}
