{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "22.23.3",
      "environment": "development",
      "env": {"APP_VARIANT": "development", "EXPO_NO_DOTENV": "1"},
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "node": "22.23.3",
      "environment": "preview",
      "env": {"APP_VARIANT": "preview", "EXPO_NO_DOTENV": "1"},
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "node": "22.23.3",
      "environment": "production",
      "env": {"APP_VARIANT": "production", "EXPO_NO_DOTENV": "1"},
      "autoIncrement": true,
      "android": {"buildType": "app-bundle"}
    }
  },
  "submit": {
    "production": {}
  }
}
