rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function unlocked(uid) { return !firestore.exists(/databases/(default)/documents/deletionJobs/$(uid)); }
    match /users/{uid}/{file} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && unlocked(uid) && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg','image/png','image/webp']
        && file.matches('^profile[.](jpg|jpeg|png|webp)$');
      allow delete: if owner(uid) && unlocked(uid);
    }
    match /{path=**} { allow read, write: if false; }
  }
}
